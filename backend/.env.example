# Server
PORT=3000
ALLOWED_ORIGINS=your-comma-separated-frontend-url
JWT_SECRET=your-random-secret

# Supabase Postgres (prefer DATABASE_URL for Render)
# Example Supabase connection string:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[projectref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[projectref].supabase.co:5432/postgres

# Optional: toggle SSL for local dev
PGSSL=true

# Supabase Storage (required for image uploads)
# Project URL from Supabase settings (API section)
SUPABASE_URL=https://[projectref].supabase.co
# Service role key from Supabase (API section). KEEP SECRET, server-only.
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Email (SMTP) configuration
# For providers like Mailtrap (testing) or your SMTP relay (SendGrid, Postmark, SES SMTP, Gmail App Password, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
# Use a verified sender for your provider (e.g., same as EMAIL_USER, or a domain-verified address)
EMAIL_FROM=no-reply@example.com
# Optional: enable verbose transport logs (true/false)
EMAIL_DEBUG=false
# Optional (development only): set to false to bypass TLS cert validation if your network does SSL inspection
EMAIL_TLS_REJECT_UNAUTHORIZED=true

# OTP code expiration in minutes
OTP_EXP_MINUTES=2