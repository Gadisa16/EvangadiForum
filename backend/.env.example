# Server
PORT=3000
ALLOWED_ORIGINS=your-comma-separated-frontend-url
JWT_SECRET=your-random-secret

# Supabase Postgres (prefer DATABASE_URL for Render)
# Example Supabase connection string:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[projectref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[projectref].supabase.co:5432/postgres

# Optional: toggle SSL for local dev
PGSSL=true

# Supabase Storage (required for image uploads)
# Project URL from Supabase settings (API section)
SUPABASE_URL=https://[projectref].supabase.co
# Service role key from Supabase (API section). KEEP SECRET, server-only.
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]